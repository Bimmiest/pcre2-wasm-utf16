{
  "name": "pcre2-wasm-utf16",
  "version": "0.2.0",
  "private": true,
  "description": "PCRE2 (16-bit, UTF mode) compiled to WebAssembly, built reproducibly from a pinned release. UTF-16 offsets map straight onto JS string indices.",
  "license": "MIT AND BSD-3-Clause WITH PCRE2-exception",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bimmiest/pcre2-wasm-utf16.git"
  },
  "homepage": "https://github.com/Bimmiest/pcre2-wasm-utf16#readme",
  "bugs": {
    "url": "https://github.com/Bimmiest/pcre2-wasm-utf16/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pcre2.wasm": "./pcre2.wasm"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/test/**",
    "pcre2.wasm",
    "pcre2.wasm.sha256",
    "build",
    "LICENSE",
    "LICENCE-PCRE2.md",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "pcre",
    "pcre2",
    "regex",
    "regexp",
    "wasm",
    "webassembly"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:wasm": "build/build.sh",
    "check:wasm": "build/build.sh --check",
    "check:package": "node scripts/check-package-contents.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,mts,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,js,mjs}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
