{
  "name": "pcre2-wasm-utf16",
  "version": "0.1.0",
  "private": true,
  "description": "PCRE2 (16-bit, UTF mode) compiled to WebAssembly, built reproducibly from a pinned release. UTF-16 offsets map straight onto JS string indices.",
  "license": "MIT AND BSD-3-Clause WITH PCRE2-exception",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bimmiest/pcre2-wasm-utf16.git"
  },
  "homepage": "https://github.com/Bimmiest/pcre2-wasm-utf16#readme",
  "bugs": {
    "url": "https://github.com/Bimmiest/pcre2-wasm-utf16/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pcre2.wasm": "./pcre2.wasm"
  },
  "files": [
    "src",
    "pcre2.wasm",
    "pcre2.wasm.sha256",
    "build",
    "LICENSE",
    "LICENCE-PCRE2.md",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "pcre",
    "pcre2",
    "regex",
    "regexp",
    "wasm",
    "webassembly"
  ],
  "scripts": {
    "build:wasm": "build/build.sh",
    "check:wasm": "build/build.sh --check",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=98 test/*.test.ts",
    "test:mutation": "stryker run",
    "check:package": "node scripts/check-package-contents.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
